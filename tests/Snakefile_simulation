NREADS=50000
NSAMP=100

GROUPS = ['0', '1']

rule main:
    input: expand('calls/samp_g{group}_{samp}.vcf', group=GROUPS, samp=list(range(NSAMP)))

#
# RULES
#

rule gfa_to_pg:
    input: 'pg.full.gfa'
    output: 'pg.full.pg'
    shell: "vg convert -g {input}  > {output}"

rule index_pg:
    input: 'pg.full.pg'
    output: 'pg.full.xg'
    shell: "vg index -x {output} {input}"

rule simulate_reads:
    input: 'pg.full.pg'
    output: 'reads/{samp}.fq.gz'
    shell: "vg sim -t 1 -x {input} -n {NREADS} -l 150 -a -P {wildcards.samp}_h0 -P {wildcards.samp}_h1 | vg view -aX - | gzip > {output}"

rule index_pg_giraffe:
    input: 'pg.full.xg'
    output: 'pg.full.giraffe.gbz'
    shell: "vg giraffe -t 1 -x {input}"

rule map_reads:
    input:
        xg='pg.full.xg',
        gbz='pg.full.giraffe.gbz',
        fq='reads/{samp}.fq.gz'
    output: 'gafs/{samp}.gaf.gz'
    shell: "vg giraffe -t 1 -x {input.xg} -o gaf -f {input.fq} | gzip > {output}"

rule pack_gaf:
    input:
        xg='pg.full.xg',
        gaf='gafs/{samp}.gaf.gz'
    output: 'gafs/{samp}.pack'
    shell: 'vg pack -t 1 -x {input.xg} -o {output} -a {input.gaf}'

rule call_variants:
    input:
        xg='pg.full.xg',
        pack='gafs/{samp}.pack'
    output: 'calls/{samp}.vcf'
    shell: 'vg call -t 1 -a -A -p ref -k {input.pack} {input.xg} > {output}'
